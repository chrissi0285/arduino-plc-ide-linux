+/* Native fires BeforeScriptExecute once per window, before any of its scripts run. Hosts use it
+ * to define script variables that the page expects. */
+static void fire_before_script_execute(HTMLInnerWindow *window)
+{
+    HTMLOuterWindow *outer_window = window->base.outer_window;
+    HTMLDocumentObj *doc_obj;
+    VARIANT var;
+
+    if(window->before_script_execute_fired || !outer_window || !outer_window->browser)
+        return;
+
+    doc_obj = outer_window->browser->doc;
+    if(!doc_obj || !doc_obj->webbrowser || !doc_obj->client_cmdtrg || outer_window->base.inner_window != window)
+        return;
+
+    /* Set before calling out, the host may run script from its handler. */
+    window->before_script_execute_fired = TRUE;
+
+    V_VT(&var) = VT_DISPATCH;
+    V_DISPATCH(&var) = (IDispatch*)&outer_window->base.IHTMLWindow2_iface;
+    IDispatch_AddRef(V_DISPATCH(&var));
+    IOleCommandTarget_Exec(doc_obj->client_cmdtrg, &CGID_DocHostCmdPriv, DOCHOST_BEFORESCRIPTEXECUTE, 0, &var, NULL);
+    VariantClear(&var);
+}
+
 static void parse_elem_text(ScriptHost *script_host, HTMLScriptElement *script_elem, LPCWSTR text)
 {
     EXCEPINFO excepinfo;
