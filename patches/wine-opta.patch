+/* Honour the native FEATURE_BROWSER_EMULATION feature control for the host process.
+ * Only the "forced" values (11001, 10001, 9999, 8888) are applied here: they make every
+ * document of the process start in that mode, independent of the host touching the
+ * document or window object before the markup (and its X-UA-Compatible meta) is parsed. */
+static compat_mode_t get_forced_browser_emulation_mode(void)
+{
+    static const WCHAR keyW[] = L"Software\\Microsoft\\Internet Explorer\\Main\\FeatureControl\\FEATURE_BROWSER_EMULATION";
+    static compat_mode_t cached = -2;
+    WCHAR path[MAX_PATH], *name;
+    DWORD value, size, type;
+    HKEY roots[2] = { HKEY_CURRENT_USER, HKEY_LOCAL_MACHINE }, key;
+    compat_mode_t mode = COMPAT_MODE_INVALID;
+    unsigned int i;
+
+    if(cached != (compat_mode_t)-2)
+        return cached;
+
+    if(!GetModuleFileNameW(NULL, path, ARRAY_SIZE(path))) {
+        cached = COMPAT_MODE_INVALID;
+        return cached;
+    }
+    name = wcsrchr(path, '\\');
+    name = name ? name + 1 : path;
+
+    for(i = 0; i < ARRAY_SIZE(roots) && mode == COMPAT_MODE_INVALID; i++) {
+        if(RegOpenKeyExW(roots[i], keyW, 0, KEY_READ, &key))
+            continue;
+        size = sizeof(value);
+        if(!RegQueryValueExW(key, name, NULL, &type, (BYTE*)&value, &size) && type == REG_DWORD) {
+            switch(value) {
+            case 11001: mode = COMPAT_MODE_IE11; break;
+            case 10001: mode = COMPAT_MODE_IE10; break;
+            case 9999:  mode = COMPAT_MODE_IE9;  break;
+            case 8888:  mode = COMPAT_MODE_IE8;  break;
+            }
+            TRACE("FEATURE_BROWSER_EMULATION %s = %lu -> forced mode %d\n", debugstr_w(name), value, mode);
+        }
+        RegCloseKey(key);
+    }
+
+    cached = mode;
+    return cached;
+}
