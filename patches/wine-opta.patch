+/* A callable wrapper returned when script reads a *method* of an embedded control as a
+ * value (jscript fetches the value first and then calls it). Calling it invokes the
+ * control's method with DISPATCH_METHOD, which is what native effectively does. */
+typedef struct {
+    IDispatch IDispatch_iface;
+    LONG ref;
+    IDispatch *target;
+    DISPID dispid;
+} PluginMethod;
+
+static inline PluginMethod *impl_from_PluginMethod(IDispatch *iface)
+{
+    return CONTAINING_RECORD(iface, PluginMethod, IDispatch_iface);
+}
+
+static HRESULT WINAPI PluginMethod_QueryInterface(IDispatch *iface, REFIID riid, void **ppv)
+{
+    if(IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDispatch)) {
+        *ppv = iface;
+        IDispatch_AddRef(iface);
+        return S_OK;
+    }
+    *ppv = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI PluginMethod_AddRef(IDispatch *iface)
+{
+    PluginMethod *This = impl_from_PluginMethod(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI PluginMethod_Release(IDispatch *iface)
+{
+    PluginMethod *This = impl_from_PluginMethod(iface);
+    LONG ref = InterlockedDecrement(&This->ref);
+    if(!ref) {
+        IDispatch_Release(This->target);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI PluginMethod_GetTypeInfoCount(IDispatch *iface, UINT *pctinfo)
+{
+    *pctinfo = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI PluginMethod_GetTypeInfo(IDispatch *iface, UINT iTInfo, LCID lcid, ITypeInfo **ppTInfo)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI PluginMethod_GetIDsOfNames(IDispatch *iface, REFIID riid, LPOLESTR *names, UINT cnt,
+        LCID lcid, DISPID *ids)
+{
+    return DISP_E_UNKNOWNNAME;
+}
+
+static HRESULT WINAPI PluginMethod_Invoke(IDispatch *iface, DISPID id, REFIID riid, LCID lcid, WORD flags,
+        DISPPARAMS *params, VARIANT *res, EXCEPINFO *ei, UINT *argerr)
+{
+    PluginMethod *This = impl_from_PluginMethod(iface);
+    DISPPARAMS dp = {0};
+
+    TRACE("(%p)->(%ld %x)\n", This, id, flags);
+
+    if(id != DISPID_VALUE || !(flags & DISPATCH_METHOD))
+        return DISP_E_MEMBERNOTFOUND;
+
+    if(params)
+        dp = *params;
+    if(dp.cNamedArgs && dp.rgdispidNamedArgs[0] == DISPID_THIS) {
+        dp.cNamedArgs--;
+        dp.rgdispidNamedArgs = dp.cNamedArgs ? dp.rgdispidNamedArgs + 1 : NULL;
+        dp.cArgs--;
+        dp.rgvarg++;
+    }
+    /* like native script engines: METHOD|PROPERTYGET works for methods and indexed properties */
+    return IDispatch_Invoke(This->target, This->dispid, &IID_NULL, lcid, DISPATCH_METHOD|DISPATCH_PROPERTYGET,
+                            &dp, res, ei, argerr);
+}
+
+static const IDispatchVtbl PluginMethodVtbl = {
+    PluginMethod_QueryInterface,
+    PluginMethod_AddRef,
+    PluginMethod_Release,
+    PluginMethod_GetTypeInfoCount,
+    PluginMethod_GetTypeInfo,
+    PluginMethod_GetIDsOfNames,
+    PluginMethod_Invoke
+};
+
+/* Uses the control's type information to tell callable members (methods and
+ * parameterized properties) from plain properties. */
+static BOOL is_plugin_method(IDispatch *disp, DISPID id, LCID lcid)
+{
+    ITypeInfo *ti;
+    TYPEATTR *attr;
+    BOOL ret = FALSE, has_prop = FALSE;
+    UINT i;
+
+    if(FAILED(IDispatch_GetTypeInfo(disp, 0, lcid, &ti)))
+        return FALSE;
+    if(SUCCEEDED(ITypeInfo_GetTypeAttr(ti, &attr))) {
+        for(i = 0; i < attr->cFuncs; i++) {
+            FUNCDESC *fd;
+            if(FAILED(ITypeInfo_GetFuncDesc(ti, i, &fd)))
+                continue;
+            if(fd->memid == id) {
+                /* methods and parameterized property getters must be called with arguments */
+                if(fd->invkind == INVOKE_FUNC || (fd->invkind == INVOKE_PROPERTYGET && fd->cParams > 0))
+                    ret = TRUE;
+                else if(fd->invkind == INVOKE_PROPERTYGET)
+                    has_prop = TRUE;
+            }
+            ITypeInfo_ReleaseFuncDesc(ti, fd);
+        }
+        ITypeInfo_ReleaseTypeAttr(ti, attr);
+    }
+    ITypeInfo_Release(ti);
+    return ret && !has_prop;
+}
