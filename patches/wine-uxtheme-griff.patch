 /***********************************************************************
+ *      MSSTYLES_IsThemeClass
+ *
+ * Check that a HTHEME is a theme class handed out by OpenThemeData.
+ *
+ * NOTES
+ *  Applications may pass handles that did not come from uxtheme, for example
+ *  when a skinning library hooks only some of the theme functions of a module.
+ *  Such handles must be rejected with E_HANDLE instead of being dereferenced.
+ */
+BOOL MSSTYLES_IsThemeClass(HTHEME theme)
+{
+    PTHEME_CLASS tc = theme;
+    BOOL ret;
+
+    if (!tc)
+        return FALSE;
+
+    __TRY
+    {
+        ret = tc->signature == THEME_CLASS_SIGNATURE;
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        ret = FALSE;
+    }
+    __ENDTRY
+
+    if (!ret)
+        WARN("Invalid theme class handle %p\n", theme);
+    return ret;
+}
+
+/***********************************************************************
  *      MSSTYLES_CloseThemeClass
  *
  * Close a theme class
